FROM python:3.12-slim
WORKDIR /app
ENV PYTHONUNBUFFERED=1 HF_HOME=/app/.hf
COPY requirements-ingest.txt .
RUN pip install --no-cache-dir -r requirements-ingest.txt
# bake the Hugging Face model into the image (no downloads at cold start)
RUN python -c "from sentence_transformers import SentenceTransformer as S; S('sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2')"
COPY src ./src
CMD exec uvicorn src.ingestion.main:app --host 0.0.0.0 --port ${PORT:-8080}
